# =============================================================================
# TrafferBot — environment variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trafferbot

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_here

# Telegram user ID that will be seeded as the owner (numeric).
OWNER_TELEGRAM_ID=123456789

# -----------------------------------------------------------------------------
# Admin panel
# -----------------------------------------------------------------------------

# Full public URL of the admin panel (used by the bot to build deep-links).
ADMIN_URL=http://localhost:80

# Optional sub-path prefix if the admin is served under a sub-directory.
# Leave empty or omit to serve at the root.
ADMIN_BASE_PATH=

# NextAuth
NEXTAUTH_SECRET=change_me_to_a_random_secret
NEXTAUTH_URL=http://localhost:80

# Telegram OIDC credentials (from BotFather → Web Login).
TELEGRAM_CLIENT_ID=your_telegram_client_id
TELEGRAM_CLIENT_SECRET=your_telegram_client_secret

# -----------------------------------------------------------------------------
# i18n
# -----------------------------------------------------------------------------

# Bot locale — BCP-47 language tag.
# The corresponding file must exist at packages/bot/src/i18n/locales/<lang>.json.
# Falls back to "en" if unset or if the file is missing.
BOT_LOCALE=en

# Admin panel locale — BCP-47 language tag used for the <html lang> attribute
# and Intl.* formatting helpers.  Falls back to "en" if unset.
NEXT_PUBLIC_ADMIN_LOCALE=en
