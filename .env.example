# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trafferbot

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
OWNER_TELEGRAM_ID=your_telegram_id

# Admin Panel
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# Optional URL prefix for the admin app, e.g. /traffer when reverse-proxied.
# Leave empty to serve the panel at the domain root.
ADMIN_BASE_PATH=

# Telegram OIDC (from BotFather > Bot Settings > Web Login)
TELEGRAM_CLIENT_ID=your_client_id
TELEGRAM_CLIENT_SECRET=your_client_secret
